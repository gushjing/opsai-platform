# 复制为 .env 后按环境修改。.env 已被 .gitignore 排除，切勿提交。
# 生产 / 公网部署前必须修改 JWT_SECRET、OPSAI_DEMO_PASSWORD，并关闭 DEMO_MODE。

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# --- 数据库（Docker Compose 会自动覆盖为容器内地址） ---
POSTGRES_USER=opsai
POSTGRES_PASSWORD=opsai_dev
POSTGRES_DB=opsai
DATABASE_URL=postgresql+asyncpg://opsai:opsai_dev@127.0.0.1:5432/opsai
POSTGRES_DSN=postgresql://opsai:opsai_dev@127.0.0.1:5432/opsai
REDIS_URL=redis://127.0.0.1:6379/0

# --- 大模型（留空则自动降级为意图感知规则模式，不影响演示） ---
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 安全 ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=120
DEMO_MODE=true
# 四个演示账号共用此口令。Docker Compose 会自动注入容器环境变量；
# 手动运行时需要用 export OPSAI_DEMO_PASSWORD=... 才会被后端读取。
OPSAI_DEMO_PASSWORD=OpsAI@Demo2026
# 前端构建时读取，需与上面保持一致
VITE_DEMO_PASSWORD=OpsAI@Demo2026

# --- 可观测性 ---
PROMETHEUS_URL=http://127.0.0.1:9090
ELASTICSEARCH_URL=http://127.0.0.1:9200
GRAFANA_URL=http://127.0.0.1:3000
TRACE_BACKEND=jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- 行为 ---
# true = 使用带故障特征的模拟数据源；false = 走数据源管理中登记的真实地址
USE_MOCK_DATASOURCE=true
ANSIBLE_INVENTORY=config/ansible_inventory.ini

# --- 可选：覆盖前端构建产物路径 ---
# OPSAI_DIST=/absolute/path/to/frontend/dist
# OPSAI_ENV_FILE=/absolute/path/to/.env
